# Illustrative TLS reverse-proxy boundary. Replace domain and certificate paths.
# Apply a current TLS policy and adapt limits to your expected legitimate traffic.
http {
    limit_req_zone $binary_remote_addr zone=mc_auth:10m rate=5r/m;
    limit_req_status 429;

    server {
        listen 80;
        server_name marketcouncil.example.com;
        return 301 https://$host$request_uri;
    }

    server {
        listen 443 ssl http2;
        server_name marketcouncil.example.com;
        ssl_certificate /etc/letsencrypt/live/marketcouncil.example.com/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/marketcouncil.example.com/privkey.pem;
        client_max_body_size 1m;

        location = /auth/login {
            limit_req zone=mc_auth burst=5 nodelay;
            proxy_pass http://127.0.0.1:8000;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        location = /auth/register {
            limit_req zone=mc_auth burst=5 nodelay;
            proxy_pass http://127.0.0.1:8000;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        location / {
            proxy_pass http://127.0.0.1:8000;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }
    }
}
